@model LoadTemplateSystem.Web.Models.ViewModels.LoadTemplateListVm

@if (Model.TotalItems > 0)
{
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 pt-3">
        <div class="text-muted small">
            @{
                var startItem = (Model.PageNumber - 1) * Model.PageSize + 1;
                var endItem = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalItems);
            }
            Showing <span class="fw-semibold">@startItem</span> to <span class="fw-semibold">@endItem</span> of <span class="fw-semibold">@Model.TotalItems</span> templates
        </div>

        <nav aria-label="Template pagination">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(Model.PageNumber - 1)"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-sortColumn="@Model.SortColumn"
                       asp-route-sortDirection="@Model.SortDirection"
                       aria-label="Previous">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    var isCurrent = i == Model.PageNumber;
                    if (i == 1 || i == Model.TotalPages || (i >= Model.PageNumber - 2 && i <= Model.PageNumber + 2))
                    {
                        <li class="page-item @(isCurrent ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-sortColumn="@Model.SortColumn"
                               asp-route-sortDirection="@Model.SortDirection">
                                @i
                            </a>
                        </li>
                    }
                    else if (i == Model.PageNumber - 3 || i == Model.PageNumber + 3)
                    {
                        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                    }
                }

                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(Model.PageNumber + 1)"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-sortColumn="@Model.SortColumn"
                       asp-route-sortDirection="@Model.SortDirection"
                       aria-label="Next">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
}

