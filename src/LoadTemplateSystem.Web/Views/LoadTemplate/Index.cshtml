@model LoadTemplateSystem.Web.Models.ViewModels.LoadTemplateListVm
@{
    ViewData["Title"] = "Maintain Load Request Template";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-controller="LoadTemplate" asp-action="Index" class="text-decoration-none">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">Maintain Load Request Template</li>
    </ol>
</nav>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-4">
        <!-- Title -->
        <h2 class="h4 fw-bold text-dark mb-3">Maintain Load Request Template</h2>

        <!-- Search Box (Exact match to Page 1 wireframe) -->
        <div class="card bg-light border-0 mb-4">
            <div class="card-body p-3">
                <form method="get" asp-action="Index" id="searchFilterForm" onsubmit="return false;">
                    <input type="hidden" name="sortColumn" id="sortColumnInput" value="@Model.SortColumn" />
                    <input type="hidden" name="sortDirection" id="sortDirectionInput" value="@Model.SortDirection" />
                    <input type="hidden" name="page" id="pageNumberInput" value="1" />

                    <div class="row g-2 align-items-center">
                        <div class="col-auto">
                            <label for="searchTermInput" class="col-form-label fw-semibold text-secondary">Name:</label>
                        </div>
                        <div class="col-md-5 col-lg-4">
                            <input type="text"
                                   id="searchTermInput"
                                   name="searchTerm"
                                   value="@Model.SearchTerm"
                                   class="form-control form-control-sm"
                                   placeholder="Enter Name"
                                   autocomplete="off" />
                        </div>
                        <div class="col-auto">
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="clearSearchBtn">
                                Reset
                            </button>
                        </div>
                        <div class="col-auto ms-auto">
                            <div class="d-inline-flex align-items-center gap-1">
                                <label class="form-label mb-0 small text-muted text-nowrap">Page Size:</label>
                                <select name="pageSize" id="pageSizeSelect" class="form-select form-select-sm">
                                    <option value="10" selected="@(Model.PageSize == 10 ? "selected" : null)">10</option>
                                    <option value="25" selected="@(Model.PageSize == 25 ? "selected" : null)">25</option>
                                    <option value="50" selected="@(Model.PageSize == 50 ? "selected" : null)">50</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Add New Button (Above Table as in Page 1 screenshot) -->
        <div class="mb-3">
            <a asp-action="Create" class="btn btn-primary px-3 fw-semibold">
                Add New
            </a>
        </div>

        <!-- Template List Container (Updated on key press) -->
        <div id="templatesContainer" class="position-relative">
            <partial name="_TemplateListPartial" model="Model" />
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal (Are you sure you want to delete? Yes/No) -->
<partial name="_DeleteConfirmModal" />

@section Scripts {
    <script src="~/js/loadTemplateIndex.js" asp-append-version="true"></script>
}
